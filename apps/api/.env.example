ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# From `vercel env pull` in apps/web (Neon), or your own Postgres
DATABASE_URL=

# From `vercel env pull` in apps/web (Upstash), or your own Redis
REDIS_URL=

# At least one LLM provider key to get real (non-fallback) responses
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-5-20250929

# From Clerk dashboard - used to verify session tokens sent by the frontend
CLERK_SECRET_KEY=
