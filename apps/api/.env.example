ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# From `vercel env pull` in apps/web (Neon), or your own Postgres
DATABASE_URL=

# From `vercel env pull` in apps/web (Upstash), or your own Redis
REDIS_URL=

# At least one LLM provider key to get real (non-fallback) responses. Anthropic
# is preferred when both are set; OPENAI_MODEL is only used as the fallback
# model when ANTHROPIC_API_KEY isn't configured. Embeddings (RAG retrieval for
# the Customer Support agent) always go through OpenAI regardless of this
# choice - Anthropic has no embeddings API.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-5-20250929
OPENAI_MODEL=gpt-4.1-mini

# From Clerk dashboard - used to verify session tokens sent by the frontend
CLERK_SECRET_KEY=

# Voice Receptionist agent - Vapi calls this API directly (not via the Next.js/Clerk
# boundary), so this shared secret is the trust boundary for /agents/voice/* instead.
# Set the same value as the Vapi Custom LLM / Server URL header/secret.
VAPI_SERVER_SECRET=

# From Twilio console - used only to send the missed-call text-back SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=

# Clerk user id that owns all calls/appointments (single-tenant demo, not per-caller)
VOICE_AGENT_USER_ID=
